# Gemini API key used for memory extraction and question answering.
# Create one at https://aistudio.google.com/apikey -- the free tier is enough
# for personal use (rate-limited per minute and per day, no card required).
#
# NOTE: EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.
# That is acceptable for local MVP development only -- see README.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional model overrides. Defaults are set in src/ai/client.ts.
# EXPO_PUBLIC_GEMINI_EXTRACT_MODEL=gemini-3.8-flash
# EXPO_PUBLIC_GEMINI_ASK_MODEL=gemini-3.1-pro-preview
